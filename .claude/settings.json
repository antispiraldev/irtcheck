{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/git_guard.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 15,
            "statusMessage": "Checking git safety"
          }
        ]
      }
    ]
  }
}
